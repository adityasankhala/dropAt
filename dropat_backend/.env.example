# ──────────────────────────────────────────────────────────────
# DropAt Backend — Environment Variables
# ──────────────────────────────────────────────────────────────
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in the REQUIRED values below
#   3. Never commit your .env file (it's in .gitignore)
# ──────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────

# PostgreSQL Database
# For Docker Compose (default): use "db" as the hostname
# For native local dev:         use "localhost" as the hostname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/dropat

# Firebase Auth (for JWT verification — shared across the team)
FIREBASE_PROJECT_ID=dropat-80f0b

# Admin Panel (use a strong, unique password in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-sharing

# ── OPTIONAL (fill when integrating these features) ──────────

# Supabase (for realtime tracking — Phase 2)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Google Maps (for geocoding / distance matrix)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ── APP SETTINGS (sensible defaults, rarely need changing) ───

APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]
TRUSTED_HOSTS=[]
AUTO_CREATE_SCHEMA=true

# Payments remain off until a Razorpay account is configured. Never enable the
# development fallback in production.
PAYMENTS_ENABLED=false
ALLOW_DEV_PAYMENT_FALLBACK=true
