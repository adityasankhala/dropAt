# Copy to .env.production only for docker-compose.production.yml. Replace every
# example value before deployment; do not commit the copied file.
POSTGRES_USER=dropat
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=dropat

DATABASE_URL=postgresql+asyncpg://dropat:replace-with-a-long-random-password@db:5432/dropat
APP_ENV=production
APP_DEBUG=false
AUTO_CREATE_SCHEMA=false
API_V1_PREFIX=/api/v1

# Use the exact public application and API hostnames.
CORS_ORIGINS=["https://app.example.com"]
TRUSTED_HOSTS=["api.example.com"]

FIREBASE_PROJECT_ID=your-firebase-project-id
ADMIN_USERNAME=replace-with-an-admin-username
ADMIN_PASSWORD=replace-with-a-long-unique-password

PAYMENTS_ENABLED=true
ALLOW_DEV_PAYMENT_FALLBACK=false
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace-me

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_KEY=replace-me
